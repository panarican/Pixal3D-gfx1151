diff --git a/csrc/common/hip_compat.h b/csrc/common/hip_compat.h
new file mode 100644
index 0000000..8744fcc
--- /dev/null
+++ b/csrc/common/hip_compat.h
@@ -0,0 +1,21 @@
+// ROCm/HIP compatibility for nvdiffrast (local port for gfx1151; not upstream).
+// Force-included into every HIP compile by setup.py (-include), because several kernels never include framework.h.
+// HIP's warp-sync intrinsics require 64-bit lane masks and return 64-bit ballots. This GPU runs 32-wide
+// waves, so the CUDA code's 32-bit masks are exact: widen them going in, narrow ballots coming out.
+#pragma once
+#if defined(__HIP__) || defined(__HIPCC__)  // device helpers: only in HIP compiles (clang -x hip), not g++ host-only .cpp
+#include <hip/hip_runtime.h>
+template<typename M> __device__ __forceinline__ unsigned int nvdr_ballot(M m, int p)     { return (unsigned int)__ballot_sync((unsigned long long)(unsigned int)m, p); }
+template<typename M> __device__ __forceinline__ int          nvdr_any(M m, int p)        { return __any_sync((unsigned long long)(unsigned int)m, p); }
+template<typename M> __device__ __forceinline__ int          nvdr_all(M m, int p)        { return __all_sync((unsigned long long)(unsigned int)m, p); }
+template<typename M, typename T> __device__ __forceinline__ unsigned int nvdr_match_any(M m, T v) { return (unsigned int)__match_any_sync((unsigned long long)(unsigned int)m, v); }
+__device__ __forceinline__ void nvdr_syncwarp() { __syncwarp(0xffffffffull); }
+template<typename M> __device__ __forceinline__ void nvdr_syncwarp(M m) { __syncwarp((unsigned long long)(unsigned int)m); }
+#define __ballot_sync    nvdr_ballot
+#define __any_sync       nvdr_any
+#define __all_sync       nvdr_all
+#define __match_any_sync nvdr_match_any
+#define __syncwarp       nvdr_syncwarp
+// No round-toward-zero reciprocal on AMD; round-to-nearest differs by at most 1 ulp (texture LOD math).
+#define __frcp_rz __frcp_rn
+#endif  // __HIP__
